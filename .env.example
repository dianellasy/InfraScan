# Application PostgreSQL (not Supabase). Compose substitutes these into DATABASE_URL.
POSTGRES_DB=infrascan
POSTGRES_USER=infrascan
POSTGRES_PASSWORD=infrascan_dev

# RabbitMQ (Compose only)
RABBITMQ_USER=infrascan
RABBITMQ_PASSWORD=infrascan_dev

# Cloudflare R2 object storage for media payloads
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Supabase Auth project URL (ES256 JWKS). No JWT secret or service-role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Comma-separated exact browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173
